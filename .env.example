# ─── GIWA Sepolia network ────────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=91342
NEXT_PUBLIC_RPC_URL=https://sepolia-rpc.giwa.io
NEXT_PUBLIC_EXPLORER_URL=https://sepolia-explorer.giwa.io
# Server-side RPC (falls back to NEXT_PUBLIC_RPC_URL). Use for API routes / scripts.
RPC_URL=https://sepolia-rpc.giwa.io

# ─── Wallet / RainbowKit ─────────────────────────────────────────────
# Get one at https://cloud.reown.com (WalletConnect)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ─── Supabase ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Admin ───────────────────────────────────────────────────────────
# Wallet that can create platform raffles + access /admin (also the contract owner).
NEXT_PUBLIC_ADMIN_WALLET=
# Wallet allowed to end/settle raffles on-chain (can be the same as the admin wallet).
WATCHDOG_ADDRESS=
# Private key for WATCHDOG_ADDRESS. Required — without it activate, end, manual-end
# and the settlement cron all fail with "Missing contract configuration". Must be the
# contract's watchdog() or owner(); keep secret, never commit.
WATCHDOG_PRIVATE_KEY=

# ─── Deployed contract addresses (fill after running deploy scripts) ──
NEXT_PUBLIC_HOLLOW_TOKEN_ADDRESS=
NEXT_PUBLIC_RAFFLES_CONTRACT_ADDRESS=
NEXT_PUBLIC_GAME_CONTRACT_ADDRESS=
# Block the raffles contract was deployed at. Floor for EntrySubmitted log scans;
# without it the RPC fallback re-walks 2,000,000 blocks and times the routes out.
RAFFLES_DEPLOY_BLOCK=

# ─── Deployment (hardhat) ────────────────────────────────────────────
# Private key used to deploy contracts to GIWA Sepolia. Keep secret; never commit.
DEPLOYER_PRIVATE_KEY=

# ─── Cron (raffle settlement) ────────────────────────────────────────
# Shared secret guarding /api/cron/settle-raffles.
CRON_SECRET=
