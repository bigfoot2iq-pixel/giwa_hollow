# ─── GIWA Sepolia network ────────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=91342
NEXT_PUBLIC_RPC_URL=https://sepolia-rpc.giwa.io
NEXT_PUBLIC_EXPLORER_URL=https://sepolia-explorer.giwa.io
# Server-side RPC (falls back to NEXT_PUBLIC_RPC_URL). Use for API routes / scripts.
RPC_URL=https://sepolia-rpc.giwa.io

# ─── Wallet / RainbowKit ─────────────────────────────────────────────
# Get one at https://cloud.reown.com (WalletConnect)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ─── Supabase ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Admin ───────────────────────────────────────────────────────────
# Wallet that can create platform raffles + access /admin (also the contract owner).
NEXT_PUBLIC_ADMIN_WALLET=
# Wallet allowed to end/settle raffles on-chain (can be the same as the admin wallet).
WATCHDOG_ADDRESS=
# Private key for WATCHDOG_ADDRESS. Required — without it activate, end, manual-end
# and the settlement cron all fail with "Missing contract configuration". Must be the
# contract's watchdog() or owner(); keep secret, never commit.
WATCHDOG_PRIVATE_KEY=

# ─── Deployed contract addresses (fill after running deploy scripts) ──
NEXT_PUBLIC_HOLLOW_TOKEN_ADDRESS=
NEXT_PUBLIC_RAFFLES_CONTRACT_ADDRESS=
NEXT_PUBLIC_GAME_CONTRACT_ADDRESS=
# NFT collection minted from /launchpad (deploy-launchpad-nft.ts).
NEXT_PUBLIC_LAUNCHPAD_NFT_ADDRESS=
# Constant-product ARIWA/ETH AMM pool behind /trade (deploy-swap-pool.ts).
NEXT_PUBLIC_SWAP_POOL_ADDRESS=

# ─── Swap pool deploy inputs ─────────────────────────────────────────
# Opening price in ARIWA per 1 ETH; used to derive the ARIWA seed when
# SWAP_POOL_TOKEN_FUNDING is unset. Empty funding values skip that side.
SWAP_POOL_TOKENS_PER_ETH=10000
SWAP_POOL_ETH_FUNDING=0.05
SWAP_POOL_TOKEN_FUNDING=500
# Swap fee in basis points (30 = 0.30%), capped on-chain at 500 (5%).
SWAP_POOL_FEE_BPS=30
# After deploying the NFT collection, move the whole ARIWA supply into the pool
# so users can buy the token they need to mint:
#   npx hardhat run scripts/fund-pool-with-ariwa.ts --network giwaSepolia
# Block the raffles contract was deployed at. Floor for EntrySubmitted log scans;
# without it the RPC fallback re-walks 2,000,000 blocks and times the routes out.
RAFFLES_DEPLOY_BLOCK=

# ─── Launchpad NFT deploy (hardhat) ──────────────────────────────────
# AriwaNFT (ERC721A) hard-codes the name ARIWA Genesis, symbol ARIGEN and the
# immutable 2,222 supply cap, matching the Elyziuma launchpad collection.
# Public metadata base; the contract appends `${tokenId}.json`.
LAUNCHPAD_BASE_URI=https://www.ariwa.xyz/api/launchpad/metadata/
# Collection owner (Ownable). Defaults to NEXT_PUBLIC_ADMIN_WALLET, then the
# deployer. The /admin launchpad writes must be signed by this wallet.
LAUNCHPAD_NFT_OWNER=
# Public phase price per NFT, paid in ARIWA (18 decimals). Defaults to 1.
LAUNCHPAD_MINT_PRICE=1
# Optional override for the payment token. Defaults to
# NEXT_PUBLIC_HOLLOW_TOKEN_ADDRESS (ARIWA). The owner can change it on-chain
# from /admin; an empty value (address zero) switches the mint back to ETH.
LAUNCHPAD_PAYMENT_TOKEN=
# Owner-controlled per-wallet cap. The contract starts at 1.
LAUNCHPAD_MAX_PER_WALLET=1
# The contract ships with the public phase closed; set true to open on deploy.
LAUNCHPAD_MINT_OPEN=false

# ─── Launchpad artwork storage ───────────────────────────────────────
# Artwork and metadata live in the private `ariwa-nft` R2 bucket through the
# NFT_BUCKET binding declared in wrangler.jsonc. Nothing is publicly readable
# from R2; /api/launchpad/metadata/[id].json and /api/launchpad/image/[id].png
# are the only public surface. Uploads are made from /admin → Launchpad.
LAUNCHPAD_COLLECTION=ariwa-genesis
LAUNCHPAD_ART_SUPPLY=2222
# HMAC secret for short-lived admin upload sessions. Required in production:
#   wrangler secret put UPLOAD_TOKEN_SECRET
# For local dev, put a random 32+ byte hex string in .env.local.
UPLOAD_TOKEN_SECRET=

# Legacy Pinata fallback. Keep these until an R2 version has been activated;
# the public routes serve Pinata only while launchpad/active.json is absent.
# The metadata directory holds `<id>.json`; its images live in the artwork
# directory below (`<id>.png`). The contract base URI must stay on the app
# proxy, never the gateway, so these CIDs remain server-side.
LAUNCHPAD_METADATA_CID=bafybeiaur5jmgea7fqpcetz5jy6xpdwllxk5dbfpzfogyxx2qsuj2d65ya
LAUNCHPAD_IMAGE_CID=bafybeifilzk37k2xxp6l7n3zuc46y2jukvsm4whh25iroexgffttpgowpm
PINATA_GATEWAY_URL=https://gateway.pinata.cloud

# ─── Launchpad holder gate (server-side balance reads) ───────────────
# Optional mainnet RPC overrides for the holder gate. Public endpoints are
# used when unset; set these when the public endpoints rate-limit you.
ETHEREUM_RPC_URL=
BNB_RPC_URL=
BASE_RPC_URL=
INK_RPC_URL=

# ─── Deployment (hardhat) ────────────────────────────────────────────
# Private key used to deploy contracts to GIWA Sepolia. Keep secret; never commit.
DEPLOYER_PRIVATE_KEY=

# ─── Public URLs ─────────────────────────────────────────────────────
# Canonical origin used for metadata/canonical links (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://www.ariwa.xyz
# Origin used when the launchpad metadata route rewrites image URLs. Defaults
# to the request origin, which is correct on Cloudflare; set it explicitly when
# the app sits behind a proxy that rewrites Host.
NEXT_PUBLIC_APP_URL=

# ─── Raffle sync / settlement tuning ─────────────────────────────────
# How far back the RPC log fallback walks when no deploy block is configured.
RAFFLES_LOG_LOOKBACK_BLOCKS=2000000
# Max raffles activated/settled per cron invocation.
SETTLE_BATCH_SIZE=20

# ─── Cron (raffle settlement) ────────────────────────────────────────
# Shared secret guarding /api/cron/settle-raffles.
CRON_SECRET=
